<Window x:Class="EngineeringTargets.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:EngineeringTargets.ViewModels"
        Title="Цели проектирования" 
        Height="900" Width="1600"
        MinHeight="600" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundColor}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <helpers:MinWeightToBoolConverter x:Key="MinWeightToBoolConverter" 
                                           xmlns:helpers="clr-namespace:EngineeringTargets.Helpers"/>
    </Window.Resources>
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов -->
        <Border Grid.Row="0" 
                Background="{StaticResource SurfaceColor}"
                BorderBrush="{StaticResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="Новый проект" 
                        Command="{Binding NewProjectCommand}" 
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Padding="12,6"/>
                <Button Content="Открыть проект" 
                        Command="{Binding OpenProjectCommand}" 
                        Style="{StaticResource SecondaryButton}"
                        Margin="0,0,8,0"
                        Padding="12,6"/>
                <Button Content="Сохранить проект" 
                        Command="{Binding SaveProjectCommand}" 
                        Style="{StaticResource SecondaryButton}"
                        Padding="12,6"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="10" Style="{StaticResource ModernTabControl}">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource ModernTabItem}"/>
            </TabControl.ItemContainerStyle>
            <TabItem Header="Уровни и цели">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <GroupBox Header="Добавить уровень" Margin="0,0,15,0" Style="{StaticResource ModernGroupBox}">
                            <StackPanel Orientation="Horizontal" Margin="0">
                                <TextBox Text="{Binding LevelsAndGoalsViewModel.NewLevelName, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="200" Margin="0,0,8,0" Style="{StaticResource ModernTextBox}"/>
                                <Button Content="Добавить" Command="{Binding LevelsAndGoalsViewModel.AddLevelCommand}" 
                                        Style="{StaticResource ModernButton}" Margin="0,0,12,0"/>
                                <TextBlock Text="или" Style="{StaticResource BodyTextBlock}" Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding LevelsAndGoalsViewModel.LevelTemplates}" 
                                          SelectedItem="{Binding LevelsAndGoalsViewModel.SelectedTemplate}"
                                          Width="250" Margin="0,0,8,0" Style="{StaticResource ModernComboBox}"/>
                                <Button Content="Добавить из шаблона" 
                                        Command="{Binding LevelsAndGoalsViewModel.AddLevelFromTemplateCommand}"
                                        Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </GroupBox>
                        
                        <GroupBox Header="Добавить цель" Style="{StaticResource ModernGroupBox}">
                            <StackPanel Orientation="Horizontal" Margin="0">
                                <ComboBox ItemsSource="{Binding LevelsAndGoalsViewModel.Levels}" 
                                          SelectedItem="{Binding LevelsAndGoalsViewModel.SelectedLevelForNewGoal}"
                                          DisplayMemberPath="Name" Width="150" Margin="0,0,8,0" Style="{StaticResource ModernComboBox}"/>
                                <TextBox Text="{Binding LevelsAndGoalsViewModel.NewGoalName, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="200" Margin="0,0,8,0" Style="{StaticResource ModernTextBox}"/>
                                <TextBlock Text="Вес:" Style="{StaticResource BodyTextBlock}" Margin="0,0,8,0"/>
                                <TextBox Text="{Binding LevelsAndGoalsViewModel.NewGoalWeight, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="80" Margin="0,0,8,0" Style="{StaticResource ModernTextBox}"/>
                                <Button Content="Добавить" Command="{Binding LevelsAndGoalsViewModel.AddGoalCommand}" 
                                        Style="{StaticResource ModernButton}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding LevelsAndGoalsViewModel.TableRows}" 
                              SelectedItem="{Binding LevelsAndGoalsViewModel.SelectedRow}"
                              AutoGenerateColumns="False" CanUserAddRows="False" 
                              SelectionMode="Single" GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                              CellEditEnding="TableDataGrid_CellEditEnding"
                              Style="{StaticResource ModernDataGrid}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}"/>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Уровень / Цель" Binding="{Binding Name}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,8"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLevel}" Value="True">
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="14"/>
                                                <Setter Property="Foreground" Value="{StaticResource PrimaryColor}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Вес (r)" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Weight, StringFormat=F3}" HorizontalAlignment="Right" Padding="12,8"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Weight, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}" 
                                                 HorizontalAlignment="Right" 
                                                 PreviewTextInput="WeightTextBox_PreviewTextInput"
                                                 Style="{StaticResource ModernTextBox}"
                                                 BorderThickness="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,15,0,0">
                        <GroupBox Header="Изменить вес" Margin="0,0,15,0" Style="{StaticResource ModernGroupBox}">
                            <StackPanel Orientation="Horizontal" Margin="0">
                                <TextBox Text="{Binding LevelsAndGoalsViewModel.NewGoalWeight, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="100" Margin="0,0,8,0" Style="{StaticResource ModernTextBox}"/>
                                <Button Content="Обновить вес" Command="{Binding LevelsAndGoalsViewModel.UpdateWeightCommand}" 
                                        Style="{StaticResource ModernButton}"/>
                            </StackPanel>
                        </GroupBox>
                        <Button Content="Удалить выбранное" Command="{Binding LevelsAndGoalsViewModel.DeleteRowCommand}" 
                                Style="{StaticResource SecondaryButton}" VerticalAlignment="Bottom"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Связи">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Добавить связь" Grid.Row="0" Margin="0,0,0,15" Style="{StaticResource ModernGroupBox}">
                        <Grid Margin="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Grid.Column="0" Text="Цель-предшественник:" Style="{StaticResource BodyTextBlock}" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LinksViewModel.FromGoalCodes}" 
                                      SelectedItem="{Binding LinksViewModel.SelectedFromGoal}" 
                                      Margin="0,0,15,0" Style="{StaticResource ModernComboBox}"/>
                            
                            <TextBlock Grid.Column="2" Text="→" VerticalAlignment="Center" FontSize="18" 
                                      Foreground="{StaticResource AccentColor}" FontWeight="SemiBold" Margin="0,0,15,0"/>
                            
                            <TextBlock Grid.Column="3" Text="Цель-последователь:" Style="{StaticResource BodyTextBlock}" Margin="0,0,8,0"/>
                            <ComboBox Grid.Column="4" ItemsSource="{Binding LinksViewModel.ToGoalCodes}" 
                                      SelectedItem="{Binding LinksViewModel.SelectedToGoal}" 
                                      Margin="0,0,15,0" Style="{StaticResource ModernComboBox}"/>
                            
                            <StackPanel Grid.Column="6" Orientation="Horizontal">
                                <Button Content="Добавить связь" Command="{Binding LinksViewModel.AddLinkCommand}" 
                                        Style="{StaticResource ModernButton}" Margin="0,0,8,0"/>
                                <Button Content="Удалить выбранную" Command="{Binding LinksViewModel.DeleteLinkCommand}" 
                                        Style="{StaticResource SecondaryButton}"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding LinksViewModel.Links}" 
                              SelectedItem="{Binding LinksViewModel.SelectedLink}"
                              AutoGenerateColumns="False" CanUserAddRows="False" 
                              GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                              Style="{StaticResource ModernDataGrid}">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}"/>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Цель-предшественник" Binding="{Binding FromGoalCode}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,8"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="→" Width="60">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="FontSize" Value="18"/>
                                        <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Padding" Value="12,8"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Цель-последователь" Binding="{Binding ToGoalCode}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Padding" Value="12,8"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Расчет">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <Button Content="Рассчитать" 
                                    Command="{Binding CalculationViewModel.CalculateCommand}" 
                                    Style="{StaticResource ModernButton}"
                                    FontSize="14"
                                    Padding="24,12" Margin="0,0,15,0"/>
                            
                            <GroupBox Header="Сортировка" 
                                    Visibility="{Binding CalculationViewModel.HasResults, Converter={StaticResource BoolToVisibilityConverter}}"
                                    Style="{StaticResource ModernGroupBox}">
                                <StackPanel Orientation="Horizontal" Margin="0">
                                    <ComboBox SelectedValue="{Binding CalculationViewModel.SortColumn}" 
                                              SelectedValuePath="Tag" DisplayMemberPath="Content" 
                                              Width="160" Margin="0,0,12,0" Style="{StaticResource ModernComboBox}">
                                        <ComboBoxItem Content="Абсолютный вес" Tag="AbsoluteWeight" IsSelected="True"/>
                                        <ComboBoxItem Content="Код цели" Tag="GoalCode"/>
                                        <ComboBoxItem Content="Название" Tag="GoalName"/>
                                        <ComboBoxItem Content="Уровень" Tag="Level"/>
                                        <ComboBoxItem Content="Ранг" Tag="Rank"/>
                                    </ComboBox>
                                    <CheckBox Content="По убыванию" IsChecked="{Binding CalculationViewModel.SortDescending}" 
                                              VerticalAlignment="Center" Style="{StaticResource ModernCheckBox}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <GroupBox Header="Фильтр и обрезка графа" 
                                Visibility="{Binding CalculationViewModel.HasResults, Converter={StaticResource BoolToVisibilityConverter}}"
                                Style="{StaticResource ModernGroupBox}">
                            <StackPanel Orientation="Horizontal" Margin="0">
                                <TextBlock Text="Минимальный абсолютный вес:" Style="{StaticResource BodyTextBlock}" Margin="0,0,8,0"/>
                                <TextBox x:Name="MinWeightThresholdTextBox"
                                         Text="{Binding CalculationViewModel.MinWeightThreshold, UpdateSourceTrigger=LostFocus}" 
                                         Width="100" Margin="0,0,12,0" Style="{StaticResource ModernTextBox}"
                                         PreviewTextInput="MinWeightTextBox_PreviewTextInput"
                                         PreviewKeyDown="MinWeightTextBox_PreviewKeyDown"
                                         LostFocus="MinWeightThresholdTextBox_LostFocus"/>
                                <Button Content="Обрезать граф" Command="{Binding CalculationViewModel.PruneGraphCommand}" 
                                        Style="{StaticResource SecondaryButton}"
                                        ToolTip="Удалить цели с абсолютным весом меньше порога"/>
                                <TextBlock Text="(цели с весом ниже порога будут удалены)" 
                                          Style="{StaticResource BodyTextBlock}"
                                          Foreground="{StaticResource TextSecondaryColor}"
                                          FontStyle="Italic" Margin="12,0,0,0"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TabControl Grid.Row="0">
                            <TabItem Header="Все результаты" Visibility="{Binding CalculationViewModel.HasResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <CheckBox Grid.Row="0" Content="Показать только отфильтрованные результаты" 
                                              IsChecked="{Binding CalculationViewModel.MinWeightThreshold, Converter={StaticResource MinWeightToBoolConverter}, Mode=OneWay}"
                                              Margin="8" Visibility="{Binding CalculationViewModel.HasResults, Converter={StaticResource BoolToVisibilityConverter}}"
                                              IsEnabled="False" Style="{StaticResource ModernCheckBox}"/>
                                    <DataGrid Grid.Row="1" 
                                              ItemsSource="{Binding CalculationViewModel.FilteredCalculationRows}" 
                                              AutoGenerateColumns="False" CanUserAddRows="False" 
                                              GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                                              Style="{StaticResource ModernDataGrid}">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}"/>
                                        </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Связи" Binding="{Binding LinksDisplay}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Padding" Value="12,8"/>
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Цель" Binding="{Binding GoalCode}" Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Padding" Value="12,8"/>
                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Название" Binding="{Binding GoalName}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Padding" Value="12,8"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Абсолютный вес (R)" Binding="{Binding AbsoluteWeight, StringFormat=F3}" Width="160">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Padding" Value="12,8"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Ранг" Binding="{Binding Rank}" Width="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Padding" Value="12,8"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>

                            <TabItem Header="10 лучших" Visibility="{Binding CalculationViewModel.HasResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGrid ItemsSource="{Binding CalculationViewModel.Top10Results}" 
                                          AutoGenerateColumns="False" CanUserAddRows="False" 
                                          GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                                          Style="{StaticResource ModernDataGrid}">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}"/>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Связи" Binding="{Binding LinksDisplay}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Padding" Value="12,8"/>
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Цель" Binding="{Binding GoalCode}" Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Padding" Value="12,8"/>
                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Название" Binding="{Binding GoalName}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Padding" Value="12,8"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Абсолютный вес (R)" Binding="{Binding AbsoluteWeight, StringFormat=F3}" Width="160">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Padding" Value="12,8"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Ранг" Binding="{Binding Rank}" Width="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Padding" Value="12,8"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="10 худших" Visibility="{Binding CalculationViewModel.HasResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGrid ItemsSource="{Binding CalculationViewModel.Bottom10Results}" 
                                          AutoGenerateColumns="False" CanUserAddRows="False" 
                                          GridLinesVisibility="Horizontal" RowHeaderWidth="0"
                                          Style="{StaticResource ModernDataGrid}">
                                    <DataGrid.ColumnHeaderStyle>
                                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>
                                    </DataGrid.ColumnHeaderStyle>
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}"/>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Связи" Binding="{Binding LinksDisplay}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Padding" Value="12,8"/>
                                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Цель" Binding="{Binding GoalCode}" Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Padding" Value="12,8"/>
                                                    <Setter Property="FontWeight" Value="Medium"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Название" Binding="{Binding GoalName}" Width="*">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Padding" Value="12,8"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Абсолютный вес (R)" Binding="{Binding AbsoluteWeight, StringFormat=F3}" Width="160">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                                    <Setter Property="Padding" Value="12,8"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Ранг" Binding="{Binding Rank}" Width="90">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Padding" Value="12,8"/>
                                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>

                            <TabItem Header="Матрица A" Visibility="{Binding CalculationViewModel.HasResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <DataGrid x:Name="MatrixADataGrid" ItemsSource="{Binding CalculationViewModel.MatrixA}" 
                                              AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                              Style="{StaticResource ModernDataGrid}">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}"/>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Код" Binding="{Binding GoalCode}" Width="80" IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Padding" Value="12,8"/>
                                                        <Setter Property="FontWeight" Value="Medium"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ScrollViewer>
                            </TabItem>

                            <TabItem Header="Матрица W" Visibility="{Binding CalculationViewModel.HasResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <DataGrid x:Name="MatrixWDataGrid" ItemsSource="{Binding CalculationViewModel.MatrixW}" 
                                              AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                              Style="{StaticResource ModernDataGrid}">
                                        <DataGrid.ColumnHeaderStyle>
                                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource ModernDataGridColumnHeader}"/>
                                        </DataGrid.ColumnHeaderStyle>
                                        <DataGrid.RowStyle>
                                            <Style TargetType="DataGridRow" BasedOn="{StaticResource ModernDataGridRow}"/>
                                        </DataGrid.RowStyle>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Код" Binding="{Binding GoalCode}" Width="80" IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Padding" Value="12,8"/>
                                                        <Setter Property="FontWeight" Value="Medium"/>
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>

                        <GroupBox Header="Ошибки валидации" Grid.Row="1" Margin="0,15,0,0" 
                                  Visibility="{Binding CalculationViewModel.HasErrors, Converter={StaticResource BoolToVisibilityConverter}}"
                                  Style="{StaticResource ModernGroupBox}">
                            <ListBox ItemsSource="{Binding CalculationViewModel.ValidationErrors}" 
                                   Height="100" MaxHeight="200"
                                   Style="{StaticResource ModernListBox}"/>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Граф">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" 
                             Text="Визуализация графа целей (только для просмотра)" 
                             Style="{StaticResource BodyTextBlock}"
                             Margin="0,0,0,10"
                             Foreground="{StaticResource TextSecondaryColor}"/>
                    
                    <ScrollViewer Grid.Row="1" 
                                HorizontalScrollBarVisibility="Auto" 
                                VerticalScrollBarVisibility="Auto"
                                Background="{StaticResource BackgroundColor}">
                        <Canvas Width="{Binding GraphViewModel.CanvasWidth}" 
                                Height="{Binding GraphViewModel.CanvasHeight}"
                                Background="{StaticResource SurfaceColor}">
                            
                            <!-- Стрелки (рисуем первыми, чтобы были под узлами) -->
                            <ItemsControl ItemsSource="{Binding GraphViewModel.Edges}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Path Stroke="{StaticResource AccentColor}" 
                                              StrokeThickness="2"
                                              Fill="{StaticResource AccentColor}"
                                              Data="{Binding PathData}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Узлы -->
                            <ItemsControl ItemsSource="{Binding GraphViewModel.Nodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas>
                                            <!-- Прямоугольник узла -->
                                            <Border Canvas.Left="{Binding Position.X}" 
                                                    Canvas.Top="{Binding Position.Y}"
                                                    Width="{Binding Width}" 
                                                    Height="{Binding Height}"
                                                    Background="{StaticResource SurfaceColor}"
                                                    BorderBrush="{StaticResource PrimaryColor}"
                                                BorderThickness="2"
                                                CornerRadius="6">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="6" ShadowDepth="3" Color="#40000000"/>
                                                </Border.Effect>
                                                <StackPanel Margin="8">
                                                    <TextBlock Text="{Binding GoalCode}" 
                                                             FontWeight="SemiBold" 
                                                             FontSize="13"
                                                             Foreground="{StaticResource PrimaryColor}"
                                                             HorizontalAlignment="Center"/>
                                                    <TextBlock Text="{Binding GoalName}" 
                                                             FontSize="11"
                                                             TextWrapping="Wrap"
                                                             TextAlignment="Center"
                                                             Foreground="{StaticResource TextPrimaryColor}"
                                                             Margin="0,4,0,0"
                                                             MaxHeight="32"
                                                             TextTrimming="CharacterEllipsis"/>
                                                    <StackPanel Orientation="Horizontal" 
                                                              HorizontalAlignment="Center" 
                                                              Margin="0,4,0,0">
                                                        <TextBlock Text="r:" 
                                                                 FontSize="9"
                                                                 Foreground="{StaticResource TextSecondaryColor}"
                                                                 Margin="0,0,2,0"/>
                                                        <TextBlock FontSize="9"
                                                                 Foreground="{StaticResource TextSecondaryColor}">
                                                            <TextBlock.Text>
                                                                <Binding Path="RelativeWeight" StringFormat="{}{0:F2}"/>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                        <TextBlock Text=" | " 
                                                                 FontSize="9"
                                                                 Foreground="{StaticResource TextSecondaryColor}"
                                                                 Margin="2,0"/>
                                                        <TextBlock Text="R:" 
                                                                 FontSize="9"
                                                                 Foreground="{StaticResource AccentColor}"
                                                                 FontWeight="Medium"
                                                                 Margin="0,0,2,0"/>
                                                        <TextBlock FontSize="9"
                                                                 Foreground="{StaticResource AccentColor}"
                                                                 FontWeight="Medium">
                                                            <TextBlock.Text>
                                                                <Binding Path="AbsoluteWeight" StringFormat="{}{0:F2}"/>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Canvas>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>

