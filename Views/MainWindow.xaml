<Window x:Class="EngineeringTargets.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:EngineeringTargets.ViewModels"
        Title="Предпроектные исследования: модуль графа целей" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <viewModels:MainViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Новый проект" Command="{Binding NewProjectCommand}"/>
                <MenuItem Header="Открыть проект" Command="{Binding OpenProjectCommand}"/>
                <MenuItem Header="Сохранить проект" Command="{Binding SaveProjectCommand}"/>
            </MenuItem>
        </Menu>

        <TabControl Grid.Row="1" Margin="5">
            <TabItem Header="Уровни и цели">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Header="Уровни" Grid.Column="0" Margin="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                                <TextBox Text="{Binding LevelsViewModel.NewLevelName, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="200" Margin="0,0,5,0"/>
                                <Button Content="Добавить уровень" Command="{Binding LevelsViewModel.AddLevelCommand}" Padding="10,5"/>
                            </StackPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding LevelsViewModel.Levels}" 
                                      SelectedItem="{Binding LevelsViewModel.SelectedLevel}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" Margin="5">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Номер" Binding="{Binding Index}" Width="100" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Button Grid.Row="2" Content="Удалить уровень" 
                                    Command="{Binding LevelsViewModel.DeleteLevelCommand}" Margin="5"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="Цели" Grid.Column="1" Margin="5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="5">
                                <ComboBox ItemsSource="{Binding GoalsViewModel.Levels}" 
                                          SelectedItem="{Binding GoalsViewModel.SelectedLevelForNewGoal}"
                                          DisplayMemberPath="Name" SelectedValuePath="Index" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding GoalsViewModel.NewGoalName, UpdateSourceTrigger=PropertyChanged}" 
                                         Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Относительный вес:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                    <TextBox Text="{Binding GoalsViewModel.NewGoalWeight, UpdateSourceTrigger=PropertyChanged}" 
                                             Width="100" Margin="0,0,5,0"/>
                                    <Button Content="Добавить цель" Command="{Binding GoalsViewModel.AddGoalCommand}" Padding="10,5"/>
                                </StackPanel>
                            </StackPanel>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding GoalsViewModel.Goals}" 
                                      SelectedItem="{Binding GoalsViewModel.SelectedGoal}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" Margin="5">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Уровень" Binding="{Binding LevelIndex}" Width="60" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="80" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Название цели" Binding="{Binding Name}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Относительный вес (r)" Binding="{Binding RelativeWeight, StringFormat=F3}" Width="150" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="5">
                                <TextBox Text="{Binding GoalsViewModel.NewGoalWeight, UpdateSourceTrigger=PropertyChanged}" 
                                         Width="100" Margin="0,0,5,0"/>
                                <Button Content="Обновить вес" Command="{Binding GoalsViewModel.UpdateWeightCommand}" Padding="10,5"/>
                                <Button Content="Удалить цель" Command="{Binding GoalsViewModel.DeleteGoalCommand}" Padding="10,5" Margin="5,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Связи">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="5">
                        <TextBlock Text="From Goal:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox ItemsSource="{Binding LinksViewModel.FromGoalCodes}" 
                                  SelectedItem="{Binding LinksViewModel.SelectedFromGoal}" Width="150" Margin="0,0,10,0"/>
                        <TextBlock Text="→" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="16"/>
                        <TextBlock Text="To Goal:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox ItemsSource="{Binding LinksViewModel.ToGoalCodes}" 
                                  SelectedItem="{Binding LinksViewModel.SelectedToGoal}" Width="150" Margin="0,0,10,0"/>
                        <Button Content="Добавить связь" Command="{Binding LinksViewModel.AddLinkCommand}" Padding="10,5"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding LinksViewModel.Links}" 
                              SelectedItem="{Binding LinksViewModel.SelectedLink}"
                              AutoGenerateColumns="False" CanUserAddRows="False" Margin="5">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="From Goal" Binding="{Binding FromGoalCode}" Width="*"/>
                            <DataGridTextColumn Header="To Goal" Binding="{Binding ToGoalCode}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="2" Content="Удалить связь" 
                            Command="{Binding LinksViewModel.DeleteLinkCommand}" Margin="5" HorizontalAlignment="Left"/>
                </Grid>
            </TabItem>

            <TabItem Header="Расчет">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="Рассчитать" 
                            Command="{Binding CalculationViewModel.CalculateCommand}" 
                            Padding="20,10" Margin="5" HorizontalAlignment="Left"/>

                    <Grid Grid.Row="1" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <GroupBox Header="Ошибки валидации" Margin="0,0,0,10" Visibility="{Binding CalculationViewModel.HasErrors, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ListBox ItemsSource="{Binding CalculationViewModel.ValidationErrors}" Height="100"/>
                                </GroupBox>

                                <GroupBox Header="Результаты расчета" Margin="0,0,0,10" Visibility="{Binding CalculationViewModel.HasResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <DataGrid ItemsSource="{Binding CalculationViewModel.GoalResults}" 
                                              AutoGenerateColumns="False" CanUserAddRows="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Код" Binding="{Binding Code}" Width="80"/>
                                            <DataGridTextColumn Header="Уровень" Binding="{Binding Level}" Width="60"/>
                                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="r" Binding="{Binding RelativeWeight, StringFormat=F3}" Width="100"/>
                                            <DataGridTextColumn Header="R" Binding="{Binding AbsoluteWeight, StringFormat=F3}" Width="100"/>
                                            <DataGridTextColumn Header="Ранг" Binding="{Binding Rank}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </GroupBox>

                                <GroupBox Header="Матрица A (Матрица смежности)" Margin="0,0,0,10" Visibility="{Binding CalculationViewModel.HasResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                        <DataGrid x:Name="MatrixADataGrid" ItemsSource="{Binding CalculationViewModel.MatrixA}" 
                                                  AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Код" Binding="{Binding GoalCode}" Width="80" IsReadOnly="True"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ScrollViewer>
                                </GroupBox>

                                <GroupBox Header="Матрица W (Матрица весов)" Visibility="{Binding CalculationViewModel.HasResults, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="200">
                                        <DataGrid x:Name="MatrixWDataGrid" ItemsSource="{Binding CalculationViewModel.MatrixW}" 
                                                  AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Код" Binding="{Binding GoalCode}" Width="80" IsReadOnly="True"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ScrollViewer>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>
</Window>

